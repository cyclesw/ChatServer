diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1b60b63..250d726 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,7 +11,7 @@ if(CMAKE_VERSION VERSION_LESS "3.1")
